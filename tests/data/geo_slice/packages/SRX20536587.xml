<EXPERIMENT_PACKAGE><EXPERIMENT accession="SRX20536587" alias="GSM7432577_r1"><IDENTIFIERS><PRIMARY_ID>SRX20536587</PRIMARY_ID><EXTERNAL_ID namespace="GEO">GSM7432577_r1</EXTERNAL_ID></IDENTIFIERS><TITLE>GSM7432577: oeVector_1; Homo sapiens; RNA-Seq</TITLE><STUDY_REF accession="SRP440126"><IDENTIFIERS><PRIMARY_ID>SRP440126</PRIMARY_ID><EXTERNAL_ID namespace="BioProject">PRJNA977602</EXTERNAL_ID></IDENTIFIERS></STUDY_REF><DESIGN><DESIGN_DESCRIPTION/><SAMPLE_DESCRIPTOR accession="SRS17844601"><IDENTIFIERS><PRIMARY_ID>SRS17844601</PRIMARY_ID><EXTERNAL_ID namespace="GEO">GSM7432577</EXTERNAL_ID></IDENTIFIERS></SAMPLE_DESCRIPTOR><LIBRARY_DESCRIPTOR><LIBRARY_NAME>GSM7432577</LIBRARY_NAME><LIBRARY_STRATEGY>RNA-Seq</LIBRARY_STRATEGY><LIBRARY_SOURCE>TRANSCRIPTOMIC</LIBRARY_SOURCE><LIBRARY_SELECTION>cDNA</LIBRARY_SELECTION><LIBRARY_LAYOUT><PAIRED/></LIBRARY_LAYOUT><LIBRARY_CONSTRUCTION_PROTOCOL>RNA was harvested using RNAiso Plus* (#9109, Takara).  1.3 ug of total RNA was used for the construction of seduencing library. RNA libraries for RNA-seg were prepared using SMARTER mRNA-Seq Library Prep Kit following manufacturer's protocol.</LIBRARY_CONSTRUCTION_PROTOCOL></LIBRARY_DESCRIPTOR></DESIGN><PLATFORM><DNBSEQ><INSTRUMENT_MODEL>DNBSEQ-G400</INSTRUMENT_MODEL></DNBSEQ></PLATFORM></EXPERIMENT><SUBMISSION lab_name="" center_name="Wuhan Union Hospital" accession="SRA1646080" alias="SUB13482540"><IDENTIFIERS><PRIMARY_ID>SRA1646080</PRIMARY_ID><SUBMITTER_ID namespace="Wuhan Union Hospital">SUB13482540</SUBMITTER_ID></IDENTIFIERS></SUBMISSION><Organization type="institute"><Name>Wuhan Union Hospital</Name><Contact email="kaixiongtao@hust.edu.cn"><Address><Street>Jiefang 1277</Street><City>Wuhan</City><Country>China</Country></Address><Name><First>Yao</First><Last>Lin</Last></Name></Contact></Organization><STUDY center_name="GEO" alias="GSE233685" accession="SRP440126"><IDENTIFIERS><PRIMARY_ID>SRP440126</PRIMARY_ID><EXTERNAL_ID namespace="BioProject" label="primary">PRJNA977602</EXTERNAL_ID><EXTERNAL_ID namespace="GEO">GSE233685</EXTERNAL_ID></IDENTIFIERS><DESCRIPTOR><STUDY_TITLE>Effect of overexpression of ESRP1 on gene expression of SGC7901 gastric cancer cells</STUDY_TITLE><STUDY_TYPE existing_study_type="Transcriptome Analysis"/><STUDY_ABSTRACT>RNA-binding proteins and their mediated alternative splicing play important roles in tumor cell invasion and migration. Here, we report that ESRP1 is a key regulator of gastric cancer cell metastasis. Overexpression of ESRP1 inhibits the invasion and migration of gastric cancer cells, in vivo and in vitro. Furthermore, we found that ESRP1 causes a wide range of alternative splicing events, and ESRP1-mediated CLSTN1 exon skipping may be a key mechanism for its inhibition of gastric cancer cell invasion and metastasis. Taken together, our data provide a molecular framework for the role of ESRP1 in gastric cancer development. Overall design: In order to study the role and mechanism of ESRP1 in the invasion and migration of gastric cancer cells, we established the SGC7901 gastric cancer cell line with stable overexpression of ESRP1. We then performed gene expression profiling analysis using data obtained from RNA-seq of 2 different cells.</STUDY_ABSTRACT><CENTER_PROJECT_NAME>GSE233685</CENTER_PROJECT_NAME></DESCRIPTOR><STUDY_LINKS><STUDY_LINK><XREF_LINK><DB>pubmed</DB><ID>38114495</ID></XREF_LINK></STUDY_LINK></STUDY_LINKS></STUDY><SAMPLE alias="GSM7432577" accession="SRS17844601"><IDENTIFIERS><PRIMARY_ID>SRS17844601</PRIMARY_ID><EXTERNAL_ID namespace="BioSample">SAMN35525969</EXTERNAL_ID><EXTERNAL_ID namespace="GEO">GSM7432577</EXTERNAL_ID></IDENTIFIERS><TITLE>oeVector_1</TITLE><SAMPLE_NAME><TAXON_ID>9606</TAXON_ID><SCIENTIFIC_NAME>Homo sapiens</SCIENTIFIC_NAME></SAMPLE_NAME><SAMPLE_LINKS><SAMPLE_LINK><XREF_LINK><DB>bioproject</DB><ID>977602</ID><LABEL>PRJNA977602</LABEL></XREF_LINK></SAMPLE_LINK></SAMPLE_LINKS><SAMPLE_ATTRIBUTES><SAMPLE_ATTRIBUTE><TAG>source_name</TAG><VALUE>gastric cancer</VALUE></SAMP