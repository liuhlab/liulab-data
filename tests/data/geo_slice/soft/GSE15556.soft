^SAMPLE = GSM389464
!Sample_title = X. tropicalis Microtubules Small RNAs
!Sample_geo_accession = GSM389464
!Sample_status = Public on Sep 01 2009
!Sample_submission_date = Apr 04 2009
!Sample_last_update_date = Jun 11 2013
!Sample_type = SRA
!Sample_channel_count = 1
!Sample_source_name_ch1 = Small RNAs from Microtubules from X.tropicalis Egg Extract
!Sample_organism_ch1 = Xenopus tropicalis
!Sample_taxid_ch1 = 8364
!Sample_characteristics_ch1 = tissue: egg extract
!Sample_characteristics_ch1 = subcellular structure: microtubules
!Sample_characteristics_ch1 = sequencing technology: 454
!Sample_molecule_ch1 = total RNA
!Sample_extract_protocol_ch1 = Small RNA library from purified microtubules from X.tropicalis egg extract. Microtubules were polymerized by taxol from Xenopus egg extract and purified by pellting thorugh a glycerol cushion.  Pellet was extracted with Trizol to obtain total RNA.  Small RNAs were ligated with linkers and converted to cDNA by reverse transcription. cDNA library was amplified by PCR.
!Sample_description = cDNA library was sequenced on a 454 Genome Sequencer FLX platform, according to Margulies et. al. Genome sequencing in microfabricated high-density picolitre reactors. Nature. 2005 Sep 15;437(7057):376-80. Epub 2005 Jul 31. Analysis of this file is described in the manuscript "Systematic and single cell analysis of Xenopus Piwi-interacting RNAs and Xiwi".
!Sample_data_processing = Base quality filtering, linker sequence removal, and structural RNA culling was performed with in-house scripts developed by Toshihiro Ohsumi and Mark Borowsky.
