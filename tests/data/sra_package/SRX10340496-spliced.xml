naling effects on S. aureus osteomyelitis via gene expression studies. Overall design: C57BL/6 mice were intramuscularly injected with recombinant adeno-associated virus expressing murine IL-27 (rAAV-IL-27) or recombinant adeno-associatd virus expressing GFP (rAAV-GFP, control) and then challenged with a S. aureus contaminated trans-tibial implant. Subsequently, infected tibia were collected on days 1, 3, 7 and 14 post-septic surgery for RNA sequencing.</STUDY_ABSTRACT><CENTER_PROJECT_NAME>GSE168896</CENTER_PROJECT_NAME></DESCRIPTOR><STUDY_LINKS><STUDY_LINK><XREF_LINK><DB>pubmed</DB><ID>36028492</ID></XREF_LINK></STUDY_LINK></STUDY_LINKS></STUDY><SAMPLE alias="GSM5172051" accession="SRS8459816"><IDENTIFIERS><PRIMARY_ID>SRS8459816</PRIMARY_ID><EXTERNAL_ID namespace="BioSample">SAMN18310875</EXTERNAL_ID><EXTERNAL_ID namespace="GEO">GSM5172051</EXTERNAL_ID></IDENTIFIERS><TITLE>GFPDay14-2</TITLE><SAMPLE_NAME><TAXON_ID>10090</TAXON_ID><SCIENTIFIC_NAME>Mus musculus</SCIENTIFIC_NAME></SAMPLE_NAME><SAMPLE_LINKS><SAMPLE_LINK><XREF_LINK><DB>bioproject</DB><ID>714525</ID><LABEL>PRJNA714525</LABEL></XREF_LINK></SAMPLE_LINK></SAMPLE_LINKS><SAMPLE_ATTRIBUTES><SAMPLE_ATTRIBUTE><TAG>source_name</TAG><VALUE>Tibia</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>strain</TAG><VALUE>C57BL/6</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>tissue</TAG><VALUE>tibia</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>genotype</TAG><VALUE>expressing GFP</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>time post-septic surgery</TAG><VALUE>day 14</VALUE></SAMPLE_ATTRIBUTE></SAMPLE_ATTRIBUTES></SAMPLE><Pool><Member member_name="" accession="SRS8459816" sample_name="GSM5172051" sample_title="GFPDay14-2" spots="59679483" bases="5967948300" tax_id="10090" organism="Mus musculus"><IDENTIFIERS><PRIMARY_ID>SRS8459816</PRIMARY_ID><EXTERNAL_ID namespace="BioSample">SAMN18310875</EXTERNAL_ID><EXTERNAL_ID namespace="GEO">GSM5172051</EXTERNAL_ID></IDENTIFIERS></Member></Pool><RUN_SET runs="1" bases="596794